<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow all cloud backup to preserve Nostr private key and zero-tracking privacy -->
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nostrange_secure_keystore.xml" />
    </device-transfer>
</data-extraction-rules>
